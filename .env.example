# Скопируйте в .env (он в .gitignore) и подставьте свои значения: cp .env.example .env
# Docker Compose подхватывает .env автоматически.

# PostgreSQL. Эти же значения использует и приложение.
DB_USER=tracker_user
DB_PASSWORD=change-me

# Ключ подписи JWT: Base64, минимум 256 бит. Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me

# Первый администратор, создается при старте, если его еще нет
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
